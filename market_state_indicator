//@version=6
indicator("Market State Indicator - Stage 1", overlay=true, max_labels_count=500)

//=====================================================================
// INPUTS
//=====================================================================

groupVWAP = "VWAP Settings"

vwapType = input.string(
     "Session",
     "VWAP Type",
     options=["Session", "Daily", "Weekly", "Monthly"],
     group=groupVWAP)

showVWAP = input.bool(true, "Show VWAP", group=groupVWAP)

groupRSI = "RSI Settings"

rsiLength = input.int(21, "RSI Length", minval=2, group=groupRSI)

bullThreshold = input.int(55, "Bull Threshold", group=groupRSI)

bearThreshold = input.int(45, "Bear Threshold", group=groupRSI)

showBackground = input.bool(false, "Background Trend", group="Display")

//=====================================================================
// VWAP ENGINE
//=====================================================================

float selectedVWAP = na

switch vwapType

    "Session" =>
        selectedVWAP := ta.vwap(close)

    "Daily" =>
        selectedVWAP := request.security(
             syminfo.tickerid,
             "D",
             ta.vwap(close),
             lookahead=barmerge.lookahead_off)

    "Weekly" =>
        selectedVWAP := request.security(
             syminfo.tickerid,
             "W",
             ta.vwap(close),
             lookahead=barmerge.lookahead_off)

    "Monthly" =>
        selectedVWAP := request.security(
             syminfo.tickerid,
             "M",
             ta.vwap(close),
             lookahead=barmerge.lookahead_off)

//=====================================================================
// RSI
//=====================================================================

rsi = ta.rsi(close, rsiLength)

//=====================================================================
// TREND ENGINE
//=====================================================================

// Strong Trend
strongBull = close > selectedVWAP and rsi > bullThreshold
strongBear = close < selectedVWAP and rsi < bearThreshold

// Weak Momentum
bullPullback = close > selectedVWAP and rsi >= bearThreshold and rsi <= bullThreshold
bearRally   = close < selectedVWAP and rsi >= bearThreshold and rsi <= bullThreshold

// Complete disagreement
neutral = (close > selectedVWAP and rsi < bearThreshold) or
          (close < selectedVWAP and rsi > bullThreshold)

//=====================================================================
// CANDLE COLORS
//=====================================================================

color strongBullColor = color.rgb(0,220,0)        // Bright Green
color bullPullbackColor = color.rgb(0,191,255)    // Light Blue
color strongBearColor = color.rgb(220,0,0)        // Bright Red
color bearRallyColor = color.rgb(170,0,255)       // Purple
color neutralColor = color.white

candleColor =
     strongBull ? strongBullColor :
     bullPullback ? bullPullbackColor :
     strongBear ? strongBearColor :
     bearRally ? bearRallyColor :
     neutralColor

// Color candle body, border and wick
barcolor(candleColor)

//=====================================================================
// VWAP PLOT
//=====================================================================

plot(
     showVWAP ? selectedVWAP : na,
     title="Selected VWAP",
     linewidth=2,
     color=color.orange)

//=====================================================================
// BACKGROUND
//=====================================================================

bgcolor(
 showBackground ?
     strongBull ? color.new(strongBullColor,90) :
     bullPullback ? color.new(bullPullbackColor,92) :
     strongBear ? color.new(strongBearColor,90) :
     bearRally ? color.new(bearRallyColor,92) :
     color.new(color.gray,95)
     : na)

//=====================================================================
// INFO TABLE
//=====================================================================

var table dashboard = table.new(position.top_right,2,4)

if barstate.islast

    table.cell(dashboard,0,0,"VWAP")
    table.cell(dashboard,1,0,vwapType)

    table.cell(dashboard,0,1,"RSI")
    table.cell(dashboard,1,1,str.tostring(rsi,"#.0"))

    table.cell(dashboard,0,2,"Trend")

    table.cell(
     dashboard,
     1,
     2,
     strongBull ? "Strong Bull" :
     bullPullback ? "Bull Pullback" :
     strongBear ? "Strong Bear" :
     bearRally ? "Bear Rally" :
     "Neutral")

    table.cell(dashboard,0,3,"Price")

    table.cell(
         dashboard,
         1,
         3,
         close > selectedVWAP ? "Above VWAP" : "Below VWAP")
