//@version=6
strategy(
     title = "BTCUSD PDH/PDL Sweep Reclaim Strategy V2",
     shorttitle = "PDH/PDL Sweep V2",
     overlay = true,
     initial_capital = 10000,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     process_orders_on_close = true)

// =====================================================
// INPUTS
// =====================================================

rrMultiple = input.float(
     title = "Risk Reward Multiple",
     defval = 2.0,
     minval = 0.5,
     step = 0.25)

reclaimBars = input.int(
     title = "Maximum Reclaim Bars",
     defval = 3,
     minval = 0,
     maxval = 20)

enableLongs = input.bool(
     title = "Enable Longs: PDL Sweep",
     defval = true)

enableShorts = input.bool(
     title = "Enable Shorts: PDH Sweep",
     defval = true)

oneTradePerSidePerDay = input.bool(
     title = "One Trade Per Side Per Day",
     defval = true)

stopBufferTicks = input.int(
     title = "Stop Buffer in Ticks",
     defval = 0,
     minval = 0,
     maxval = 1000)

showLevels = input.bool(
     title = "Show PDH / PDL",
     defval = true)

showMarkers = input.bool(
     title = "Show Sweep / Entry Markers",
     defval = true)

showStopTarget = input.bool(
     title = "Show Active Stop / Target",
     defval = true)

// =====================================================
// MANUAL PREVIOUS DAY HIGH / LOW LOGIC
// This avoids request.security alignment confusion.
// Day 1 high/low becomes PDH/PDL on Day 2.
// =====================================================

isNewDay = ta.change(time("D")) != 0

var float currentDayHigh = na
var float currentDayLow = na
var float prevDayHigh = na
var float prevDayLow = na

if na(currentDayHigh)
    currentDayHigh := high
    currentDayLow := low

if isNewDay
    prevDayHigh := currentDayHigh
    prevDayLow := currentDayLow
    currentDayHigh := high
    currentDayLow := low
else
    currentDayHigh := math.max(currentDayHigh, high)
    currentDayLow := math.min(currentDayLow, low)

// =====================================================
// DAILY TRADE LOCKS
// =====================================================

var bool longTradedToday = false
var bool shortTradedToday = false

if isNewDay
    longTradedToday := false
    shortTradedToday := false

// =====================================================
// STATE VARIABLES
// =====================================================

var bool longWaitingForReclaim = false
var int longSweepBar = na
var float longSweepLow = na

var bool shortWaitingForReclaim = false
var int shortSweepBar = na
var float shortSweepHigh = na

var float activeStop = na
var float activeTarget = na

stopBuffer = stopBufferTicks * syminfo.mintick

// =====================================================
// VALID LEVEL CHECK
// =====================================================

levelsReady = not na(prevDayHigh) and not na(prevDayLow)

// =====================================================
// FRESH SWEEP CONDITIONS
// Important:
// A sweep is only fresh if the previous candle was NOT already
// beyond the level.
// This prevents repeated entries after price stays below/above
// for many candles.
// =====================================================

freshLongSweep =
     levelsReady and
     enableLongs and
     strategy.position_size == 0 and
     not longWaitingForReclaim and
     low < prevDayLow and
     (isNewDay or low[1] >= prevDayLow) and
     (not oneTradePerSidePerDay or not longTradedToday)

freshShortSweep =
     levelsReady and
     enableShorts and
     strategy.position_size == 0 and
     not shortWaitingForReclaim and
     high > prevDayHigh and
     (isNewDay or high[1] <= prevDayHigh) and
     (not oneTradePerSidePerDay or not shortTradedToday)

// =====================================================
// START LONG SETUP
// =====================================================

if freshLongSweep
    longWaitingForReclaim := true
    longSweepBar := bar_index
    longSweepLow := low

// While waiting, keep deepest sweep low
if longWaitingForReclaim
    longSweepLow := math.min(longSweepLow, low)

// =====================================================
// START SHORT SETUP
// =====================================================

if freshShortSweep
    shortWaitingForReclaim := true
    shortSweepBar := bar_index
    shortSweepHigh := high

// While waiting, keep highest sweep high
if shortWaitingForReclaim
    shortSweepHigh := math.max(shortSweepHigh, high)

// =====================================================
// RECLAIM WINDOW CALCULATION
// If reclaimBars = 3:
// Sweep bar itself is bar 0.
// Valid reclaim bars are 0, 1, 2, 3.
// =====================================================

longBarsSinceSweep =
     longWaitingForReclaim
     ? bar_index - longSweepBar
     : na

shortBarsSinceSweep =
     shortWaitingForReclaim
     ? bar_index - shortSweepBar
     : na

longReclaimWindowValid =
     longWaitingForReclaim and
     longBarsSinceSweep <= reclaimBars

shortReclaimWindowValid =
     shortWaitingForReclaim and
     shortBarsSinceSweep <= reclaimBars

// =====================================================
// RECLAIM CONDITIONS
// =====================================================

longReclaim =
     longReclaimWindowValid and
     close > prevDayLow

shortReclaim =
     shortReclaimWindowValid and
     close < prevDayHigh

// =====================================================
// EXPIRE STALE SETUPS
// =====================================================

if longWaitingForReclaim and longBarsSinceSweep > reclaimBars
    longWaitingForReclaim := false
    longSweepBar := na
    longSweepLow := na

if shortWaitingForReclaim and shortBarsSinceSweep > reclaimBars
    shortWaitingForReclaim := false
    shortSweepBar := na
    shortSweepHigh := na

// =====================================================
// ENTRY AND EXIT LOGIC
// Use if / else if so both long and short cannot trigger
// on the same candle.
// =====================================================

if strategy.position_size == 0 and longReclaim

    entryPrice = close
    stopPrice = longSweepLow - stopBuffer
    riskDistance = entryPrice - stopPrice

    if riskDistance > 0
        targetPrice = entryPrice + riskDistance * rrMultiple

        activeStop := stopPrice
        activeTarget := targetPrice

        strategy.entry(
             id = "LONG",
             direction = strategy.long)

        strategy.exit(
             id = "LONG EXIT",
             from_entry = "LONG",
             stop = stopPrice,
             limit = targetPrice)

        longTradedToday := true

    longWaitingForReclaim := false
    longSweepBar := na
    longSweepLow := na

else if strategy.position_size == 0 and shortReclaim

    entryPrice = close
    stopPrice = shortSweepHigh + stopBuffer
    riskDistance = stopPrice - entryPrice

    if riskDistance > 0
        targetPrice = entryPrice - riskDistance * rrMultiple

        activeStop := stopPrice
        activeTarget := targetPrice

        strategy.entry(
             id = "SHORT",
             direction = strategy.short)

        strategy.exit(
             id = "SHORT EXIT",
             from_entry = "SHORT",
             stop = stopPrice,
             limit = targetPrice)

        shortTradedToday := true

    shortWaitingForReclaim := false
    shortSweepBar := na
    shortSweepHigh := na

// =====================================================
// RESET ACTIVE STOP / TARGET WHEN FLAT
// =====================================================

if strategy.position_size == 0 and not longReclaim and not shortReclaim
    activeStop := na
    activeTarget := na

// =====================================================
// PLOTS
// =====================================================

plot(
     showLevels ? prevDayHigh : na,
     title = "Previous Day High",
     color = color.new(color.green, 0),
     linewidth = 2,
     style = plot.style_linebr)

plot(
     showLevels ? prevDayLow : na,
     title = "Previous Day Low",
     color = color.new(color.red, 0),
     linewidth = 2,
     style = plot.style_linebr)

plot(
     showStopTarget and strategy.position_size != 0 ? activeStop : na,
     title = "Active Stop Loss",
     color = color.new(color.red, 0),
     linewidth = 2,
     style = plot.style_linebr)

plot(
     showStopTarget and strategy.position_size != 0 ? activeTarget : na,
     title = "Active Take Profit",
     color = color.new(color.blue, 0),
     linewidth = 2,
     style = plot.style_linebr)

// =====================================================
// VISUAL MARKERS
// =====================================================

plotshape(
     showMarkers and freshLongSweep,
     title = "Fresh PDL Sweep",
     style = shape.triangledown,
     location = location.belowbar,
     color = color.new(color.orange, 0),
     size = size.tiny,
     text = "PDL Sweep")

plotshape(
     showMarkers and freshShortSweep,
     title = "Fresh PDH Sweep",
     style = shape.triangleup,
     location = location.abovebar,
     color = color.new(color.orange, 0),
     size = size.tiny,
     text = "PDH Sweep")

plotshape(
     showMarkers and longReclaim,
     title = "Long Entry",
     style = shape.labelup,
     location = location.belowbar,
     color = color.new(color.green, 0),
     textcolor = color.white,
     size = size.small,
     text = "LONG")

plotshape(
     showMarkers and shortReclaim,
     title = "Short Entry",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.new(color.red, 0),
     textcolor = color.white,
     size = size.small,
     text = "SHORT")
